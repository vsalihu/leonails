# Copy to .env and fill in. Never commit real secrets.

# PostgreSQL 14+ with the btree_gist and citext extensions available.
DATABASE_URL=postgres://leonails:leonails@localhost:5432/leonails
# Public base URL used in email links.
APP_URL=http://localhost:3000
# At least 32 random characters: `openssl rand -base64 48`
APP_SECRET=

# --- Email ---------------------------------------------------------------
# devmailbox: messages are rendered and captured in the database (visible in
#             Admin > Notifications). Nothing is delivered externally.
# smtp:       real delivery through any SMTP provider (Resend, Postmark, SES, ...).
MAIL_DRIVER=devmailbox
MAIL_FROM="Rugile Nail Atelier <bookings@example.invalid>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Image storage -------------------------------------------------------
# local: files under STORAGE_DIR (use a persistent volume in production).
# s3:    any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, ...).
STORAGE_DRIVER=local
STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Background jobs -----------------------------------------------------
# true: the web server also runs the email outbox worker (single-instance hosting).
# Otherwise run `npm run worker` as a separate process, or call
# POST /api/cron/run-jobs with header `Authorization: Bearer $CRON_SECRET` every minute.
WORKER_IN_PROCESS=true
CRON_SECRET=

# Number of reverse proxies in front of the app (used to read the client IP
# from X-Forwarded-For for rate limiting). 0 = do not trust the header.
TRUSTED_PROXY_COUNT=0
